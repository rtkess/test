<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cedar Ridge Crisis Room</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@500;700&family=Source+Sans+3:wght@400;600;700&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
:root{--green:#154734;--gold:#FFB81C;--bg:#f5f7f6;--surface:#fff;--ink:#18221d;--muted:#56635c;--line:#d4ddd8;--tint:#e7efea;--goldtint:#fff4d6;
--good:#1d6b3f;--goodbg:#e4f3e9;--bad:#a3271f;--badbg:#fbe9e7;--warn:#8a5a00;
--f-display:"Zilla Slab",Georgia,serif;--f-body:"Source Sans 3",-apple-system,"Segoe UI",sans-serif;--f-mono:"IBM Plex Mono",ui-monospace,monospace}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 var(--f-body)}
h1,h2,h3{font-family:var(--f-display);line-height:1.2;margin:0 0 8px}
header{background:var(--green);color:#fff;border-bottom:5px solid var(--gold)}
.wrap{max-width:1040px;margin:0 auto;padding-left:16px;padding-right:16px}
header .wrap{padding-block:16px 14px}
.eyebrow{font:500 .74rem/1 var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin-bottom:6px}
header h1{font-size:clamp(1.5rem,4vw,2rem);margin:0}
main{padding-block:18px 48px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px;min-width:0}
.narrow{max-width:620px}
.muted{color:var(--muted)} .small{font-size:.88rem;color:var(--muted);margin-bottom:0}
label.f{display:block;font-weight:700;color:var(--green);margin-top:14px}
label.f span{display:block;font-weight:400;color:var(--muted);font-size:.88rem}
input{font:500 1rem var(--f-mono);text-transform:uppercase;padding:9px 12px;border:2px solid var(--green);border-radius:8px;background:var(--surface);color:var(--ink);width:100%;max-width:280px;margin-top:6px}
.btn{appearance:none;border:2px solid var(--green);background:var(--green);color:#fff;font:700 .95rem var(--f-body);padding:9px 16px;border-radius:8px;cursor:pointer}
.btn.ghost{background:transparent;color:var(--green)}
.link{appearance:none;border:0;background:none;color:var(--green);text-decoration:underline;font:600 .88rem var(--f-body);cursor:pointer}
button:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.btnrow{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.who{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
.pill{background:var(--tint);color:var(--green);font-weight:700;font-size:.88rem;padding:4px 12px;border-radius:999px}
.pill.code,.code{font-family:var(--f-mono);font-weight:500}
.steps{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.steps span{font:500 .78rem var(--f-mono);padding:4px 10px;border-radius:999px;background:var(--tint);color:var(--muted)}
.steps span.on{background:var(--gold);color:#154734}.steps span.done{background:var(--green);color:#fff}
.gauges{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:14px}
.gauge{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.gauge .lbl{font:500 .72rem var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.gauge .val{font:700 1.6rem/1.1 var(--f-display);font-variant-numeric:tabular-nums}
.d{font:500 .8rem var(--f-mono)}.d.up{color:var(--good)}.d.down{color:var(--bad)}
.track{height:8px;border-radius:99px;background:var(--tint);overflow:hidden;margin-top:6px}
.track span{display:block;height:100%;border-radius:99px;background:var(--green)}.track span.low{background:var(--bad)}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.stack{display:grid;gap:16px;align-content:start;min-width:0}
.event{background:var(--surface);border:1px solid var(--line);border-left:6px solid var(--gold);border-radius:10px;padding:16px 18px}
.tag{font:500 .74rem var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--warn)}
.event h2{font-size:1.35rem;margin:4px 0 6px}.event p{margin:0}
.private{background:var(--goldtint);border-radius:10px;padding:14px 16px}
.private .lock{font:500 .72rem var(--f-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--warn)}
.private p{margin:6px 0 0}
.options{display:grid;gap:10px}
.opt{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:start;border:1.5px solid var(--line);border-radius:10px;padding:12px}
.code{font-size:.85rem;background:var(--tint);color:var(--green);padding:3px 8px;border-radius:6px;white-space:nowrap}
.confirm{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:14px}
.confirm input{width:150px;margin-top:0}
.fb{border-radius:10px;padding:12px 14px;margin-top:12px;font-size:.95rem}
.fb.ok{background:var(--goodbg);color:var(--good)}.fb.bad{background:var(--badbg);color:var(--bad)}.fb.info{background:var(--tint)}
.fb .btn{margin-left:8px}
.deltas{font:500 .82rem var(--f-mono);margin-top:6px}
.save{margin:14px 0 16px;border:2px solid var(--gold)}
.bigcode{font:500 2rem var(--f-mono);color:var(--green);letter-spacing:.06em}
@media (max-width:760px){.grid2{grid-template-columns:1fr}.gauges{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
</head>
<body>
<header><div class="wrap"><div class="eyebrow">HPA 5340 · Committee game</div><h1>Cedar Ridge Crisis Room</h1></div></header>
<main class="wrap" id="app"></main>
<div id="live" aria-live="polite" style="position:absolute;left:-9999px"></div>
<script>
var ROUNDS = [
 {tag:"Round 1 · Week 1", title:"The 90-day plan",
  text:"The board chair: “Summit Valley's offer is on the table. Before we vote, bring us a 90-day plan that shows Cedar Ridge can stand on its own.”",
  brief:{
   CEO:"The board chair told you privately that two trustees already favor selling. They will only change their minds for a plan with specific numbers and named owners.",
   CNO:"Exit interviews blame mandatory overtime and nights without support. If the nurse residency is cut, first-year turnover will jump back above 20 percent.",
   CMO:"The hospitalists will back a discharge-delay PIT if they help write the order sets. Dr. Russell is quietly lobbying trustees to accept the offer.",
   CFO:"Claim denials are at 9 percent; every point costs about $2.9 million a year. Agency nurses cost $4.1 million last year. Training is $1.2 million."},
  posts:[{r:"CFO",t:"Fastest cash is cutting training and freezing hiring. I know it's ugly."},{r:"CNO",t:"If we cut the residency, we'll pay more in agency nurses within six months. Exit interviews are clear on that."},{r:"CMO",t:"Hospitalists are ready to work on discharge delays if they help design it. That's a win on cost per case and on denials."}],
  opts:[
   {code:"SV1-A", t:"Cut training and the nurse residency, and freeze hiring.", d:{cash:10,quality:-5,staff:-15,trust:0},
    fb:"Cash improves on paper, but staff morale drops and agency costs will climb back. Chapter 11: cutting HR only saves money if quality and retention hold."},
   {code:"SV1-B", t:"Charter PITs on denials and discharge delays, negotiate realistic goals with each unit, and protect training.", d:{cash:5,quality:5,staff:5,trust:10},
    fb:"A credible plan with owners and measures. Chapters 3 and 13: excellent care, not budget cuts, produces sustainable cash."},
   {code:"SV1-C", t:"Ask Summit Valley to pause talks while finance pushes insurers for higher prices.", d:{cash:0,quality:0,staff:0,trust:-10},
    fb:"Price renegotiation is “not promising,” and stalling looks like avoidance to the board."}]},
 {tag:"Round 2 · Week 2", title:"Surveyors at the door",
  text:"The Joint Commission arrives unannounced. On day one, a surveyor finds equipment in a 4 West exit corridor and asks about a medication event that never appeared in the reporting system.",
  brief:{
   CEO:"Summit Valley's CEO called: a bad survey result will lower their offer by $20 million.",
   CNO:"A charge nurse admits she talked a new nurse out of reporting the event “to protect the numbers.”",
   CMO:"Surveyors will interview physicians tomorrow. Two hospitalists have complained about the corridor clutter for months.",
   CFO:"A formal correction plan will cost about $150,000 in overtime and storage changes."},
  posts:[{r:"CEO",t:"We cannot afford a bad survey right now. What do we tell them?"},{r:"CNO",t:"The unreported event is the real problem. If we hide it and they find out, we're finished."},{r:"CFO",t:"$150K is real money, but a lower offer would cost far more."}],
  opts:[
   {code:"SV2-A", t:"Clear the corridor tonight and keep the unreported event quiet.", d:{cash:0,quality:-10,staff:-5,trust:-15},
    fb:"Hiding the event breaks Integrity and the protections from Module 1. Surveyors interview staff, and the story comes out."},
   {code:"SV2-B", t:"Own the findings: report the event, apply just culture, and charter a PIT on corridor storage with a correction plan.", d:{cash:-2,quality:10,staff:5,trust:5},
    fb:"Anything unsafe is a never event (Chapter 12). Honest reporting and a real fix show surveyors, and the board, a system that learns."},
   {code:"SV2-C", t:"Tell the surveyors the night shift ignored the rules.", d:{cash:0,quality:-5,staff:-15,trust:-5},
    fb:"Blaming individuals for a system problem violates just culture. Staff stop speaking up, and the corridor fills again next month."}]},
 {tag:"Round 3 · Week 3", title:"The board votes",
  text:"The board will vote Friday on Summit Valley's offer. Your committee's recommendation goes to the trustees on Thursday.",
  brief:{
   CEO:"Three trustees are undecided. They want to know how the community keeps a voice in Cedar Ridge's future.",
   CNO:"Nurses fear layoffs under Summit Valley, which closed inpatient units at two hospitals it bought.",
   CMO:"Summit Valley would move specialty diabetes care to its own campus, 30 miles away.",
   CFO:"Summit Valley would also accept a partnership: shared purchasing and IT, worth about $6 million a year, with no change of ownership."},
  posts:[{r:"CMO",t:"Losing diabetes care locally contradicts the CHNA priority we just funded."},{r:"CFO",t:"The partnership gets us real savings without selling."},{r:"CEO",t:"Whatever we recommend, it has to show the community keeps a voice."}],
  opts:[
   {code:"SV3-A", t:"Recommend independence with the turnaround plan and a shared savings contract tied to the diabetes center.", d:{cash:5,quality:5,staff:5,trust:5},
    fb:"Bold. It works only if the turnaround is already credible, so it depends on what the board saw in rounds 1 and 2."},
   {code:"SV3-B", t:"Recommend a partnership: shared purchasing and IT with Summit Valley, a local board, no layoffs, and diabetes care kept in town.", d:{cash:15,quality:0,staff:5,trust:10},
    fb:"Chapter 15: affiliation is a real strategic option when it protects mission, control, and caregivers. The questions about mission fit and decision-making were asked and answered."},
   {code:"SV3-C", t:"Recommend accepting the offer as written.", d:{cash:20,quality:-10,staff:-20,trust:-5},
    fb:"Cedar Ridge survives as a Summit Valley campus, but 4 West and local diabetes care close. The mission the community created it for is lost."}]}
];
/* ===== Settings the instructor can change ===== */
/* Role codes: give each student the code for their role (Canvas message or group welcome post). */
var ROLE_CODES = {"ORCHID":"CEO", "HARBOR":"CNO", "LANTERN":"CMO", "MERIDIAN":"CFO"};
/* Optional opening dates for rounds 2 and 3 (YYYY-MM-DD). Leave as "" to open immediately. */
var ROUND_OPENS = ["", "", ""];

/* ===== Game logic ===== */
var ROLE_NAMES = {CEO:"Chief executive officer", CNO:"Chief nursing officer (Maya Torres)", CMO:"Chief medical officer", CFO:"Chief financial officer"};
var METERS = [{k:"cash",n:"Cash"},{k:"quality",n:"Quality"},{k:"staff",n:"Staff"},{k:"trust",n:"Board trust"}];
var START = {cash:40, quality:45, staff:40, trust:50};
var S = {role:null, path:[], last:null};
var app = document.getElementById("app");

function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];}); }
function say(t){ var l=document.getElementById("live"); l.textContent=""; setTimeout(function(){ l.textContent=t; },40); }
function clamp(v){ return Math.max(0,Math.min(100,v)); }
function meters(path){ var m=Object.assign({},START);
  path.forEach(function(letter,i){ var o=ROUNDS[i].opts["ABC".indexOf(letter)]; METERS.forEach(function(x){ m[x.k]=clamp(m[x.k]+(o.d[x.k]||0)); }); });
  return m; }
function pathCode(path){ return "SV-"+path.join(""); }
function parsePath(txt){
  var t=txt.trim().toUpperCase().replace(/\s+/g,"");
  if(t===""||t==="SV"||t==="SV-") return [];
  var m=t.match(/^SV-?([ABC]{1,3})$/); if(!m) return null;
  return m[1].split("");
}
function isOpen(r){ var d=ROUND_OPENS[r]; if(!d) return true; return new Date() >= new Date(d+"T00:00:00"); }
function deltaText(d){ return METERS.map(function(x){ var v=d[x.k]||0; return v?x.n+" "+(v>0?"+":"")+v:null; }).filter(Boolean).join(" · ")||"No change"; }
function gaugesHTML(m,prev){
  return '<div class="gauges">'+METERS.map(function(x){ var v=m[x.k], d=prev?v-prev[x.k]:0;
    return '<div class="gauge"><div class="lbl">'+x.n+'</div><div class="val">'+v+(d?' <span class="d '+(d>0?'up':'down')+'">'+(d>0?'+':'')+d+'</span>':'')+'</div><div class="track"><span class="'+(v<30?'low':'')+'" style="width:'+v+'%"></span></div></div>'; }).join("")+'</div>';
}
function stepsHTML(){ var n=S.path.length;
  return '<div class="steps">'+ROUNDS.map(function(r,i){ return '<span class="'+(i<n?'done':(i===n?'on':''))+'">Round '+(i+1)+'</span>'; }).join("")+'<span class="'+(n>=3?'on':'')+'">Board vote</span></div>'; }
function ending(path,m){
  var c=path[2];
  if(c==="C") return {h:"Sold to Summit Valley", t:"Cedar Ridge becomes a Summit Valley campus. 4 West and local diabetes care close within a year."};
  if(c==="A") return (m.trust>=60&&m.quality>=55)?{h:"The board votes for independence", t:"Your turnaround was credible, so the trustees back it. Cash is still thin, so next year's goals matter."}:{h:"The board narrowly votes to sell", t:"Independence needed a track record the board hadn't seen. Your choices in rounds 1 and 2 decided this vote."};
  return (m.trust>=50)?{h:"A partnership, on Cedar Ridge's terms", t:"Shared purchasing and IT bring savings, the local board stays, and diabetes care stays in town."}:{h:"A partnership, on Summit Valley's terms", t:"Low board trust weakened your committee's hand. Summit Valley gets more control than planned."};
}

/* ===== Screens ===== */
function screenStart(msg){
  app.innerHTML='<section class="card narrow">'+
    '<h2>Enter the crisis room</h2>'+
    '<p>Cedar Ridge Community Hospital has about 60 days of cash, and Summit Valley Health wants to buy it. Your committee advises the board over three rounds. Each of you holds a different role and sees information the others don\'t, so share what you learn in your committee\'s Canvas discussion.</p>'+
    '<label class="f" for="rc">Your role code<span>From your instructor. Keep it to yourself.</span></label><input id="rc" autocomplete="off" spellcheck="false">'+
    '<label class="f" for="pc">Your committee\'s path code<span>Leave blank for Round 1. After that, use the latest code posted in your committee\'s discussion.</span></label><input id="pc" autocomplete="off" spellcheck="false" placeholder="SV-">'+
    (msg?'<div class="fb bad">'+esc(msg)+'</div>':'')+
    '<div class="btnrow"><button class="btn" id="enter" type="button">Enter</button></div></section>';
  var go=function(){
    var role=ROLE_CODES[document.getElementById("rc").value.trim().toUpperCase()];
    if(!role){ screenStart("That role code isn't recognized. Check the code your instructor sent you."); return; }
    var p=parsePath(document.getElementById("pc").value);
    if(p===null){ screenStart("That path code isn't valid. It looks like SV-B or SV-BA. Leave it blank for Round 1."); return; }
    S.role=role; S.path=p; S.last=null; render(); say("Welcome, "+ROLE_NAMES[role]+".");
  };
  document.getElementById("enter").onclick=go;
  ["rc","pc"].forEach(function(id){ document.getElementById(id).onkeydown=function(e){ if(e.key==="Enter") go(); }; });
}
function render(){
  var n=S.path.length, m=meters(S.path), prev=n?meters(S.path.slice(0,-1)):null;
  var head='<div class="who"><span class="pill">'+esc(ROLE_NAMES[S.role])+'</span><span class="pill code">Path '+esc(pathCode(S.path))+'</span><button class="link" id="out" type="button">Switch role or code</button></div>'+stepsHTML()+gaugesHTML(m,S.last?prev:null);
  if(S.last){
    head+='<div class="fb ok"><b>Round '+n+' result.</b> '+esc(S.last.fb)+'<div class="deltas">'+esc(deltaText(S.last.d))+'</div></div>'+
      '<div class="card save"><h3>Your committee\'s new path code</h3><div class="bigcode" id="newcode">'+esc(pathCode(S.path))+'</div>'+
      '<p>Post this code in your committee\'s Canvas discussion and include it with your decision submission. Next round, everyone enters it to continue.</p>'+
      '<div class="btnrow"><button class="btn ghost" id="copy" type="button">Copy code</button></div><div id="cfb" aria-live="polite"></div></div>';
  }
  if(n>=3){
    var e=ending(S.path,m);
    app.innerHTML=head+'<section class="card"><div class="tag">Friday · The board votes</div><h2>'+esc(e.h)+'</h2><p>'+esc(e.t)+'</p>'+
      '<p class="muted">Post your final path code in the Board Hearing discussion, then compare outcomes with the other committee.</p></section>';
    wire(); return;
  }
  var R=ROUNDS[n];
  if(!isOpen(n)){
    app.innerHTML=head+'<section class="card"><h2>Round '+(n+1)+' opens '+esc(ROUND_OPENS[n])+'</h2><p>Come back then with your committee\'s path code, '+esc(pathCode(S.path))+'.</p></section>';
    wire(); return;
  }
  app.innerHTML=head+
    '<div class="grid2"><div class="stack">'+
      '<section class="event"><div class="tag">'+esc(R.tag)+' · Event card</div><h2>'+esc(R.title)+'</h2><p>'+esc(R.text)+'</p></section>'+
      '<section class="private"><div class="lock">Private briefing · '+esc(S.role)+' only</div><p>'+esc(R.brief[S.role])+'</p><p class="small">Share what matters in your committee\'s discussion. Your teammates can\'t see this.</p></section>'+
    '</div><section class="card"><h2>Your committee\'s options</h2>'+
      '<p class="muted">Discuss in Canvas first. When your committee agrees, <b>one member</b> enters the code for your choice.</p>'+
      '<div class="options">'+R.opts.map(function(o){ return '<div class="opt"><span class="code">'+o.code+'</span><span>'+esc(o.t)+'</span></div>'; }).join("")+'</div>'+
      '<div class="confirm"><label for="dc"><b>Decision code</b></label><input id="dc" autocomplete="off" spellcheck="false" placeholder="SV'+(n+1)+'-?"><button class="btn" id="go" type="button">Enter decision</button></div>'+
      '<div id="dfb" aria-live="polite"></div></section></div>';
  wire();
  var go=function(){
    var v=document.getElementById("dc").value.trim().toUpperCase(), fb=document.getElementById("dfb");
    var idx=-1; R.opts.forEach(function(o,i){ if(o.code===v) idx=i; });
    if(idx<0){ fb.innerHTML='<div class="fb bad">That code isn\'t one of this round\'s options. Codes for Round '+(n+1)+' start with SV'+(n+1)+'-.</div>'; return; }
    if(!fb.dataset.ok){ fb.dataset.ok="1"; fb.innerHTML='<div class="fb info">Enter <b>'+esc(v)+'</b> for your committee? Decisions can\'t be undone. <button class="btn" id="yes" type="button">Confirm</button></div>';
      document.getElementById("yes").onclick=function(){ var o=R.opts[idx]; S.path.push("ABC"[idx]); S.last=o; render(); window.scrollTo(0,0); say("Decision entered. New path code "+pathCode(S.path)); }; return; }
  };
  document.getElementById("go").onclick=go;
  document.getElementById("dc").onkeydown=function(e){ if(e.key==="Enter") go(); };
}
function wire(){
  document.getElementById("out").onclick=function(){ S={role:null,path:[],last:null}; screenStart(); };
  var c=document.getElementById("copy");
  if(c) c.onclick=function(){ var t=pathCode(S.path), f=document.getElementById("cfb");
    var ok=function(){ f.innerHTML='<div class="fb ok">Copied '+esc(t)+'.</div>'; };
    var fail=function(){ var r=document.createRange(); r.selectNodeContents(document.getElementById("newcode")); var s=window.getSelection(); s.removeAllRanges(); s.addRange(r); f.innerHTML='<div class="fb info">The code is selected. Press Ctrl+C (or ⌘+C) to copy.</div>'; };
    try{ navigator.clipboard.writeText(t).then(ok,fail); }catch(e){ fail(); } };
}
screenStart();

</script>
</body>
</html>
